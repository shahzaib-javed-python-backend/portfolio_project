{
  "version": 2,
  "builds": [
    {
      "src": "portfolio_project/wsgi.py",
      "use": "@vercel/python",
      "config": { 
        "maxLambdaSize": "15mb", 
        "runtime": "python3.11",
        "requirements": "Django==5.1.4\nwhitenoise==6.7.0\nsqlparse==0.5.0\nasgiref==3.8.1"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "(.*)",
      "dest": "portfolio_project/wsgi.py"
    }
  ]
}